<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>To-Do Ledger — Live</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#10140f;
    --surface:#171d15;
    --surface-2:#1e261c;
    --border:#2b3427;
    --text:#eaefe4;
    --text-muted:#8ba081;
    --text-faint:#5c6b57;
    --amber:#e8a33d;
    --teal:#5fc9b8;
    --coral:#d9603b;
    --blue:#5b93c9;
    --sans:'IBM Plex Sans', -apple-system, sans-serif;
    --mono:'IBM Plex Mono', 'SF Mono', monospace;
    --display:'Space Grotesk', var(--sans);
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background:
      radial-gradient(circle at 15% 0%, rgba(232,163,61,0.06), transparent 45%),
      radial-gradient(circle at 85% 10%, rgba(95,201,184,0.05), transparent 40%),
      var(--bg);
    color:var(--text);
    font-family:var(--sans);
    line-height:1.5;
    -webkit-font-smoothing:antialiased;
    padding-bottom:3rem;
  }
  :focus-visible{outline:2px solid var(--amber); outline-offset:3px; border-radius:2px;}
  .wrap{max-width:880px; margin:0 auto; padding:0 1.5rem;}

  header.hero{padding:3rem 0 2rem; border-bottom:1px solid var(--border);}
  .eyebrow{
    font-family:var(--mono); font-size:0.72rem; letter-spacing:0.18em; text-transform:uppercase;
    color:var(--teal); margin:0 0 0.9rem; display:flex; align-items:center; gap:0.6rem;
  }
  .eyebrow::before{content:""; width:7px; height:7px; border-radius:50%; background:var(--teal); box-shadow:0 0 0 3px rgba(95,201,184,0.18);}
  .eyebrow.live::before{background:var(--amber); box-shadow:0 0 0 3px rgba(232,163,61,0.18); animation:pulse 2s ease-in-out infinite;}
  @keyframes pulse{0%,100%{opacity:1;} 50%{opacity:0.35;}}
  h1{font-family:var(--display); font-weight:700; font-size:clamp(1.8rem, 4vw, 2.6rem); letter-spacing:-0.02em; margin:0 0 0.5rem;}
  .hero-sub{color:var(--text-muted); max-width:52ch; margin:0 0 1.8rem; font-size:0.95rem; display:flex; align-items:center; gap:0.6rem; flex-wrap:wrap;}
  .sync-note{font-family:var(--mono); font-size:0.78rem; color:var(--text-faint);}
  .refresh-btn{
    font-family:var(--mono); font-size:0.76rem; color:var(--text);
    background:var(--surface-2); border:1px solid var(--border); border-radius:999px;
    padding:0.35rem 0.85rem; cursor:pointer; display:inline-flex; align-items:center; gap:0.4rem;
  }
  .refresh-btn:hover{border-color:var(--text-faint);}
  .refresh-btn:disabled{opacity:0.5; cursor:default;}
  .refresh-btn svg{width:12px; height:12px;}
  .refresh-btn.spinning svg{animation:spin 0.7s linear infinite;}
  @keyframes spin{to{transform:rotate(360deg);}}

  .readouts{
    display:grid; grid-template-columns:repeat(auto-fit, minmax(130px, 1fr)); gap:1px;
    background:var(--border); border:1px solid var(--border); border-radius:10px; overflow:hidden;
  }
  .readout{background:var(--surface); padding:1rem 1.1rem;}
  .readout .label{font-family:var(--mono); font-size:0.66rem; text-transform:uppercase; letter-spacing:0.08em; color:var(--text-faint); margin-bottom:0.4rem;}
  .readout .value{font-family:var(--mono); font-weight:600; font-size:1.4rem; color:var(--text); font-variant-numeric:tabular-nums;}
  .readout.accent .value{color:var(--amber);}
  .readout.warn .value{color:var(--coral);}

  section{padding:2rem 0;}
  .controls{display:flex; gap:0.5rem; flex-wrap:wrap; margin-bottom:1.2rem;}
  .chip{
    font-family:var(--mono); font-size:0.74rem; border:1px solid var(--border);
    background:var(--surface-2); color:var(--text-muted); padding:0.35rem 0.75rem;
    border-radius:999px; cursor:pointer;
  }
  .chip.active{border-color:var(--text-faint); color:var(--text); background:#232c20;}

  .todo-list{display:flex; flex-direction:column; gap:0.6rem;}
  .todo-card{
    background:var(--surface); border:1px solid var(--border); border-radius:10px;
    padding:1rem 1.2rem; display:grid; grid-template-columns:auto 1fr auto; gap:0.9rem; align-items:start;
  }
  .todo-card.done{opacity:0.55;}
  .status-dot{width:10px; height:10px; border-radius:50%; margin-top:0.35rem;}
  .status-dot.open{background:var(--amber);}
  .status-dot.done{background:var(--teal);}
  .status-dot.cancelled{background:var(--text-faint);}
  .todo-main .title{font-weight:500; font-size:0.98rem; margin-bottom:0.3rem;}
  .todo-card.done .title{text-decoration:line-through; color:var(--text-muted);}
  .todo-meta{display:flex; gap:0.7rem; flex-wrap:wrap; font-family:var(--mono); font-size:0.72rem; color:var(--text-faint);}
  .tag{padding:0.12rem 0.5rem; border-radius:5px; background:var(--surface-2); border:1px solid var(--border);}
  .tag.priority-high{color:var(--coral); border-color:rgba(217,96,59,0.4);}
  .tag.priority-medium{color:var(--amber); border-color:rgba(232,163,61,0.4);}
  .tag.priority-low{color:var(--text-muted);}
  .tag.overdue{color:var(--coral); border-color:rgba(217,96,59,0.4);}
  .todo-code{font-family:var(--mono); font-size:0.72rem; color:var(--text-faint); white-space:nowrap; text-align:right;}
  .todo-card{cursor:pointer; transition:border-color 0.15s;}
  .todo-card:hover{border-color:var(--text-faint);}
  .todo-card.expanded{border-color:var(--teal);}
  .todo-detail{
    grid-column:1 / -1; margin-top:0.6rem; padding-top:0.8rem; border-top:1px solid var(--border);
    display:grid; gap:0.6rem; font-size:0.88rem; color:var(--text-muted);
  }
  .todo-detail .detail-row{display:flex; gap:0.5rem; flex-wrap:wrap;}
  .todo-detail .detail-label{font-family:var(--mono); font-size:0.7rem; text-transform:uppercase; letter-spacing:0.06em; color:var(--text-faint); min-width:110px;}
  .todo-detail .detail-value{color:var(--text);}
  .todo-detail .notes-block{white-space:pre-wrap; line-height:1.5;}

  .empty{color:var(--text-faint); font-family:var(--mono); font-size:0.85rem; padding:2rem 0; text-align:center;}
  .error-banner{
    background:rgba(217,96,59,0.1); border:1px solid rgba(217,96,59,0.35); color:#f0a988;
    border-radius:8px; padding:0.8rem 1rem; font-family:var(--mono); font-size:0.78rem; margin-bottom:1rem;
  }
  footer{max-width:880px; margin:0 auto; padding:1.5rem 1.5rem 0; color:var(--text-faint); font-size:0.76rem; font-family:var(--mono);}

  @media (prefers-reduced-motion: reduce){ *{animation:none !important; transition:none !important;} }
</style>
</head>
<body>
<div class="wrap">
  <header class="hero">
    <p class="eyebrow live" id="eyebrow">Field Log · Live from Supabase</p>
    <h1>To-Do Ledger</h1>
    <p class="hero-sub">
      <span id="syncNote" class="sync-note">Loading…</span>
      <button class="refresh-btn" id="refreshBtn" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><path d="M21 3v6h-6"/></svg>
        Refresh
      </button>
    </p>
    <div class="readouts" id="readouts">
      <div class="readout"><div class="label">Open</div><div class="value">—</div></div>
      <div class="readout accent"><div class="label">High priority</div><div class="value">—</div></div>
      <div class="readout warn"><div class="label">Overdue</div><div class="value">—</div></div>
      <div class="readout"><div class="label">Done</div><div class="value">—</div></div>
    </div>
  </header>

  <section>
    <div class="controls" id="statusFilters"></div>
    <div id="errorBanner"></div>
    <div class="todo-list" id="todoList"><div class="empty">Loading your todos…</div></div>
  </section>
</div>

<footer>Queries your Supabase <code>todos</code> table directly on load, via a read-only public key.</footer>

<script>
const SUPABASE_URL = 'https://qqsexwiqhaaimxuswsei.supabase.co';
const SUPABASE_KEY = 'sb_publishable_sP5r-i7mnqziZGqalP_M2A_XekLpolS';
const CACHE_KEY = 'todo_ledger_cache_v1';

let allTodos = [];
let activeStatus = 'open';
let expandedCode = null;

const STATUS_ORDER = { open: 0, done: 1, cancelled: 2 };
const PRIORITY_ORDER = { high: 0, medium: 1, low: 2, null: 3 };

function timeAgo(iso){
  const diff = Math.round((Date.now() - new Date(iso).getTime())/1000);
  if(diff < 10) return 'just now';
  if(diff < 60) return diff + 's ago';
  if(diff < 3600) return Math.round(diff/60) + 'm ago';
  if(diff < 86400) return Math.round(diff/3600) + 'h ago';
  return Math.round(diff/86400) + 'd ago';
}

async function loadCache(){
  try{
    const res = await window.storage.get(CACHE_KEY, false);
    if(res && res.value) return JSON.parse(res.value);
  } catch(e){ /* no cache yet */ }
  return null;
}
async function saveCache(data){
  try{
    await window.storage.set(CACHE_KEY, JSON.stringify({ data, fetchedAt: new Date().toISOString() }), false);
  } catch(e){ /* storage unavailable, ignore */ }
}

async function fetchTodos(){
  const url = `${SUPABASE_URL}/rest/v1/todos?select=*,project:projects(title,code),asset:assets(item,code)&order=due_date.asc.nullslast`;
  const res = await fetch(url, { headers: { apikey: SUPABASE_KEY, Authorization: `Bearer ${SUPABASE_KEY}` } });
  if(!res.ok) throw new Error(`Supabase returned ${res.status}`);
  return res.json();
}

function renderReadouts(todos){
  const open = todos.filter(t=>t.status==='open');
  const highOpen = open.filter(t=>t.priority==='high');
  const today = new Date().toISOString().slice(0,10);
  const overdue = open.filter(t=>t.due_date && t.due_date < today);
  const done = todos.filter(t=>t.status==='done');
  const vals = document.querySelectorAll('#readouts .value');
  vals[0].textContent = open.length;
  vals[1].textContent = highOpen.length;
  vals[2].textContent = overdue.length;
  vals[3].textContent = done.length;
}

function renderFilters(todos){
  const counts = { all: todos.length, open: 0, done: 0, cancelled: 0 };
  todos.forEach(t=> counts[t.status] = (counts[t.status]||0)+1);
  const box = document.getElementById('statusFilters');
  box.innerHTML = '';
  [['all','All'],['open','Open'],['done','Done'],['cancelled','Cancelled']].forEach(([key,label])=>{
    const chip = document.createElement('button');
    chip.className = 'chip' + (activeStatus===key ? ' active' : '');
    chip.textContent = `${label} (${counts[key]||0})`;
    chip.addEventListener('click', ()=>{ activeStatus = key; renderFilters(todos); renderList(todos); });
    box.appendChild(chip);
  });
}

function renderList(todos){
  const today = new Date().toISOString().slice(0,10);
  let rows = activeStatus==='all' ? todos.slice() : todos.filter(t=>t.status===activeStatus);
  rows.sort((a,b)=>{
    const s = STATUS_ORDER[a.status]-STATUS_ORDER[b.status];
    if(s!==0) return s;
    const p = (PRIORITY_ORDER[a.priority||'null']) - (PRIORITY_ORDER[b.priority||'null']);
    if(p!==0) return p;
    return (a.due_date||'9999') < (b.due_date||'9999') ? -1 : 1;
  });

  const list = document.getElementById('todoList');
  if(rows.length===0){ list.innerHTML = '<div class="empty">Nothing here.</div>'; return; }

  list.innerHTML = rows.map(t=>{
    const isOverdue = t.status==='open' && t.due_date && t.due_date < today;
    const parts = [];
    if(t.priority) parts.push(`<span class="tag priority-${t.priority}">${t.priority}</span>`);
    if(t.project && t.project.title) parts.push(`<span class="tag">${t.project.title}</span>`);
    if(t.due_date) parts.push(`<span class="tag${isOverdue ? ' overdue' : ''}">${isOverdue ? 'overdue · ' : 'due '}${t.due_date}</span>`);
    if(t.domain_tag) parts.push(`<span class="tag">${t.domain_tag}</span>`);

    const isExpanded = expandedCode === t.code;
    let detailHtml = '';
    if(isExpanded){
      const rows2 = [];
      rows2.push(`<div class="detail-row"><span class="detail-label">Status</span><span class="detail-value">${t.status}</span></div>`);
      if(t.priority) rows2.push(`<div class="detail-row"><span class="detail-label">Priority</span><span class="detail-value">${t.priority}</span></div>`);
      if(t.due_date) rows2.push(`<div class="detail-row"><span class="detail-label">Due date</span><span class="detail-value">${t.due_date}</span></div>`);
      if(t.domain_tag) rows2.push(`<div class="detail-row"><span class="detail-label">Domain</span><span class="detail-value">${t.domain_tag}</span></div>`);
      if(t.project && t.project.title) rows2.push(`<div class="detail-row"><span class="detail-label">Project</span><span class="detail-value">${t.project.title}${t.project.code ? ' ('+t.project.code+')' : ''}</span></div>`);
      if(t.asset && t.asset.item) rows2.push(`<div class="detail-row"><span class="detail-label">Asset</span><span class="detail-value">${t.asset.item}${t.asset.code ? ' ('+t.asset.code+')' : ''}</span></div>`);
      if(t.created_at) rows2.push(`<div class="detail-row"><span class="detail-label">Created</span><span class="detail-value">${new Date(t.created_at).toLocaleString()}</span></div>`);
      if(t.completed_at) rows2.push(`<div class="detail-row"><span class="detail-label">Completed</span><span class="detail-value">${new Date(t.completed_at).toLocaleString()}</span></div>`);
      rows2.push(`<div class="detail-row"><span class="detail-label">Notes</span><span class="detail-value notes-block">${t.notes ? t.notes : 'No notes.'}</span></div>`);
      detailHtml = `<div class="todo-detail">${rows2.join('')}</div>`;
    }

    return `<div class="todo-card ${t.status==='done'?'done':''} ${isExpanded ? 'expanded' : ''}" data-code="${t.code}">
      <div class="status-dot ${t.status}"></div>
      <div class="todo-main">
        <div class="title">${t.title}</div>
        <div class="todo-meta">${parts.join('')}</div>
        ${detailHtml}
      </div>
      <div class="todo-code">${t.code}</div>
    </div>`;
  }).join('');

  list.querySelectorAll('.todo-card').forEach(card=>{
    card.addEventListener('click', ()=>{
      const code = card.getAttribute('data-code');
      expandedCode = (expandedCode === code) ? null : code;
      renderList(allTodos);
    });
  });
}

function renderAll(todos){
  allTodos = todos;
  renderReadouts(todos);
  renderFilters(todos);
  renderList(todos);
}

async function refresh(showSpinner){
  const btn = document.getElementById('refreshBtn');
  const eyebrow = document.getElementById('eyebrow');
  const banner = document.getElementById('errorBanner');
  if(showSpinner) btn.classList.add('spinning');
  btn.disabled = true;
  banner.innerHTML = '';
  try{
    const todos = await fetchTodos();
    renderAll(todos);
    saveCache(todos);
    document.getElementById('syncNote').textContent = 'Synced just now';
    eyebrow.textContent = 'Field Log · Live from Supabase';
    eyebrow.classList.add('live');
  } catch(err){
    banner.innerHTML = `<div class="error-banner">Couldn't reach Supabase (${err.message}). ${allTodos.length ? 'Showing last-known data.' : ''}</div>`;
    eyebrow.textContent = 'Field Log · offline';
    eyebrow.classList.remove('live');
    if(allTodos.length){ document.getElementById('syncNote').textContent = 'Last synced ' + timeAgo(window.__lastFetchedAt || new Date().toISOString()); }
  } finally {
    btn.classList.remove('spinning');
    btn.disabled = false;
  }
}

document.getElementById('refreshBtn').addEventListener('click', ()=> refresh(true));

(async function init(){
  const cached = await loadCache();
  if(cached && cached.data && cached.data.length){
    window.__lastFetchedAt = cached.fetchedAt;
    renderAll(cached.data);
    document.getElementById('syncNote').textContent = 'Showing cached data from ' + timeAgo(cached.fetchedAt) + ' — refreshing…';
  }
  await refresh(false);
})();
</script>
</body>
</html>
